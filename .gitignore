# MoAI Directory Management
# .moai local-only directories (user projects only)
# git applies the LAST matching rule, so ignore rules must come before the
# negations that re-include tracked subpaths.
.moai/*
.moai/error_logs/
.moai/archived-skills/
.moai/backups/
.moai/analytics/
.moai/archive/
.moai/docs/
.moai/work/
.moai-backups/
# Tracked in git: config/, memory/, project/, scripts/, specs/
!.moai/scripts/
!.moai/scripts/**
!.moai/specs/
!.moai/specs/**
!.moai/memory/
!.moai/memory/**
!.moai/config/
!.moai/config/**
!.moai/project/
!.moai/project/**
# Must stay local-only (placed after the negations above so they win)
.moai/config/config.json
# .moai local development scripts (not distributed)
.moai/scripts/sync-*.py
.moai/scripts/phase*.py
.moai/scripts/phase*.sh
.moai/scripts/sync-*.sh
.moai/scripts/*sync*.sh
.moai/scripts/__pycache__/
# .moai runtime dirs (never commit)
.moai/logs/
.moai/temp/
.moai/cache/
.moai/reports/
# OS junk must never surface inside re-included .moai subtrees
.DS_Store
